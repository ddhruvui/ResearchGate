# Copy to .env and fill in. .env is gitignored.
# RunPod S3 API keys (RunPod console -> Settings -> S3 API Keys).
# The SAME account keys reach both volumes; access is scoped per-bucket by volume id.
AWS_ACCESS_KEY_ID=user_xxx
AWS_SECRET_ACCESS_KEY=rps_xxx

# RunPod ACCOUNT api key (rpa_...) — creates the pod and lets it self-terminate.
RUNPOD_API_KEY=rpa_xxx

# --- Volumes (both EU-RO-1) ---
# SOURCE is READ-ONLY and is never mounted by the pod. Do not change this value.
SOURCE_VOLUME_ID=8qik4zxpxq
# RESULTS is mounted at /workspace and is the only writable target.
RESULTS_VOLUME_ID=x3n7kgbbit

RUNPOD_S3_REGION=eu-ro-1
RUNPOD_S3_ENDPOINT=https://s3api-eu-ro-1.runpod.io
RUNPOD_DATACENTER=EU-RO-1

# --- Pod sizing ---
RUNPOD_VCPU=16
RUNPOD_IMAGE=python:3.11-slim
RUNPOD_CPU_FLAVORS='["cpu3c","cpu3g","cpu3m","cpu5c","cpu5g","cpu5m"]'
RUNPOD_CONTAINER_DISK_GB=20
